SetEnvIfNoCase User-Agent "SemrushBot" !bad_bot
SetEnvIfNoCase User-Agent "Ahrefs" !bad_bot
SetEnvIfNoCase User-Agent "Semrush" !bad_bot

# Canonical host and URL normalization for Apache/LiteSpeed cPanel hosting.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS and consolidate www onto the non-www canonical host.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.bhasinpathlabs\.com$ [NC]
  RewriteRule ^ https://bhasinpathlabs.com%{REQUEST_URI} [R=301,L]

  # Redirect explicit index.html requests to their clean directory URL.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://bhasinpathlabs.com/$1 [R=301,L,NE]

  # The former homecollection route has one exact, relevant replacement.
  RewriteRule ^homecollection/?$ https://bhasinpathlabs.com/home-collection.html [R=301,L,NE]

  # Explicitly retire obsolete URLs reported by Search Console.
  RewriteRule ^covid19testinformation\.pdf$ - [G,L]
  RewriteRule ^covid19rtpcr/?$ - [G,L]
  RewriteRule ^test-information/this-is-my-second-title/?$ - [G,L]
  RewriteRule ^test/disease/(polycystic-ovary-syndrome-pcos|malnutrition|heart-disease|liver-disease|cardiovascular-disease|hiv-infection-and-aids)/?$ - [G,L]
</IfModule>

# Browser caching and compression for Apache/LiteSpeed cPanel hosting.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:avif|webp|jpe?g|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  Header append Vary Accept-Encoding
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

Options -Indexes

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
